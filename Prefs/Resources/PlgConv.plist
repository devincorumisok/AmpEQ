<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Room simulation from an impulse-response WAV (for example HiBy's "Open_Air" files). The first 2 s of the file are used. Level is the volume of the processed sound (-20 to +20 dB). Adds 5 ms of latency while on.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.ampeq.ipod7</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>key</key>
			<string>plgConv</string>
			<key>label</key>
			<string>Enable</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>get</key>
			<string>convFileName:</string>
			<key>label</key>
			<string>File</string>
		</dict>
		<dict>
			<key>action</key>
			<string>chooseIR</string>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Choose impulse response…</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Level</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>default</key>
			<real>0.0</real>
			<key>fmt</key>
			<string>%+.1f dB</string>
			<key>get</key>
			<string>valueLabel:</string>
			<key>id</key>
			<string>lbl_convLevel</string>
			<key>label</key>
			<string>Level</string>
			<key>valueKey</key>
			<string>convLevel</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>cellClass</key>
			<string>AEQSliderCell</string>
			<key>default</key>
			<real>0.0</real>
			<key>defaults</key>
			<string>com.ampeq.ipod7</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>key</key>
			<string>convLevel</string>
			<key>label</key>
			<string>Level</string>
			<key>max</key>
			<integer>20</integer>
			<key>min</key>
			<integer>-20</integer>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
			<key>step</key>
			<real>0.1</real>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>action</key>
			<string>resetPlugin</string>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>isDestructive</key>
			<true/>
			<key>label</key>
			<string>Reset to defaults</string>
		</dict>
	</array>
	<key>title</key>
	<string>Convolution</string>
</dict>
</plist>
